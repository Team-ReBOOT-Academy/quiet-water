HTTP_HOST=
HTTP_PORT=
SERVICE_NAME=
SERVICE_VERSION=

# Стабильные идентификаторы. Пустое значение берёт default из application.conf.
STUDENT_ID=llnightll
STRATEGY_ID=quiet-water
DISPLAY_NAME=Quiet Water

# Kafka. Пустые адрес и топик оставляют health в DEGRADED.
KAFKA_BOOTSTRAP_SERVERS=
KAFKA_USERNAME=
KAFKA_PASSWORD=
KAFKA_TOPIC=
KAFKA_GROUP_ID=quiet-water-llnightll
KAFKA_SECURITY_PROTOCOL=SASL_SSL
KAFKA_SASL_MECHANISM=SCRAM-SHA-512
KAFKA_AUTO_OFFSET_RESET=earliest
# Пусто — рекомендации и регистрация уходят в KAFKA_TOPIC.
KAFKA_OUTBOUND_TOPIC=

# Эти поля заполняет ответ account.registration.accepted.
SECRET_KEY=
ACCOUNT_ID=
GROUP_ID=
SESSION_ID=

# Пороги walk-forward
N=90
K=45
M=10
W=20
T=0.55
RSI_PERIOD=14
RSI_OVERSOLD=30
RSI_OVERBOUGHT=70
